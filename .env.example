# Local Vite development server proxy target.
VITE_API_PROXY_TARGET=http://localhost:8080

# Backend API base URLs used by frontend clients during local development.
VITE_AUTH_API=http://localhost:8080
VITE_COMMUNICATION_RISK_API=http://localhost:8080

# Replace with a non-secret project identifier available in your backend.
VITE_COMMUNICATION_RISK_PROJECT_ID=replace-with-project-id

# Slack integration API path and workspace link.
VITE_SLACK_API=/api/slack
VITE_SLACK_URL=https://your-workspace.slack.com
